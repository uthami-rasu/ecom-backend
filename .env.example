# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Set to the number of proxies in front of the app (e.g. 1 behind a load balancer)
# so rate limiting sees the real client IP.
TRUST_PROXY=false

# ── PostgreSQL (docker compose up -d exposes it on 5433, or cloud DB) ──
DB_HOST=localhost
DB_PORT=5433
DB_USER=ecom
DB_PASSWORD=ecom_dev_password
DB_NAME=BOSSCO
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_LOGGING=false
# Optional full connection URL (overrides DB_* if provided):
# DATABASE_URL=postgres://user:password@host:port/BOSSCO?sslmode=require

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://bossco.vercel.app,https://bosscodyfruits.com,https://www.bosscodyfruits.com

# ── Rate limiting ────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Applies to login, register, refresh, contact and newsletter endpoints
AUTH_THROTTLE_LIMIT=10

# ── Caching (0 disables the catalog cache) ───────────────
CACHE_TTL_MS=60000

# ── Uploads & Cloud Object Storage (local or S3 / Supabase / Cloudflare R2) ──
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://api.bosscodyfruits.com
MAX_UPLOAD_BYTES=5242880
STORAGE_DRIVER=local
# For S3 / Supabase / Cloudflare R2:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=bossco
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/bossco
# S3_FORCE_PATH_STYLE=true

# ── Payments ─────────────────────────────────────────────
# Only "mock" exists today; "razorpay" plugs in behind the same PaymentProvider interface.
PAYMENT_PROVIDER=mock
PAYMENT_KEY_SECRET=change-me-payment-key-secret
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# ── Shipping (rupees) ────────────────────────────────────
FREE_SHIPPING_THRESHOLD=999
STANDARD_SHIPPING_FEE=49
EXPRESS_SHIPPING_FEE=150

# ── Docs ─────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ── Seed (npm run seed) ──────────────────────────────────
ADMIN_EMAIL=admin@bossco.local
ADMIN_PASSWORD=ChangeMe@12345

# ── Email (Resend HTTP API or Gmail SMTP) ────────────────────
# resend (recommended on cloud like Render) | smtp | log (console) | memory (tests)
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Bossco Naturals <onboarding@resend.dev>"
# Base URL of the storefront, used for links in emails
STOREFRONT_URL=https://bosscodyfruits.com

# ── Email OTP ────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
